# ── Frontend environment ────────────────────────────────────────────
# Copy to .env for local dev:  cp .env.example .env
# In production these are injected by the platform (e.g. Cloud Run).

# Public URL of the backend API — REQUIRED.
# Read at request time and injected into HTML as window.__RF_CONFIG__.backendUrl.
# Local default (if unset) is http://localhost:8081.
BACKEND_URL=http://localhost:8081

# Surfaced in window.__RF_CONFIG__.version (optional). Defaults to 1.0.0.
APP_VERSION=1.0.0

# Surfaced in window.__RF_CONFIG__.env (optional). Defaults to production.
NODE_ENV=development

# Port (optional). Defaults to 8080. Cloud Run injects this.
PORT=8080
