# ── Backend environment ─────────────────────────────────────────────
# Copy to .env for local dev:  cp .env.example .env
# In production these are injected by the platform (e.g. Cloud Run);
# never commit a real .env.

# Anthropic API key — REQUIRED for /api/analyze.
# Without it the server still boots, but /api/analyze returns 500.
# In production, mount from a secret store (e.g. Secret Manager), never plaintext.
ANTHROPIC_API_KEY=sk-ant-...

# Model override (optional). Defaults to claude-opus-4-7.
ANTHROPIC_MODEL=claude-opus-4-7

# Google Cloud project for the Firestore client.
# REQUIRED in production. Cloud Run injects GOOGLE_CLOUD_PROJECT automatically.
GOOGLE_CLOUD_PROJECT=root-and-fruit-app

# CORS allowlist (optional). Defaults to "*".
# Set to the frontend's public URL once the domain is final.
ALLOWED_ORIGIN=*

# Port (optional). Defaults to 8080. Cloud Run injects this.
PORT=8080
