# ── Backend environment ─────────────────────────────────────────────
# Copy to .env for local dev:  cp .env.example .env
# In production these are injected by the platform (e.g. Cloud Run);
# never commit a real .env.

# Anthropic API key — REQUIRED for /api/analyze.
# Without it the server still boots, but /api/analyze returns 500.
# In production, mount from a secret store (e.g. Secret Manager), never plaintext.
ANTHROPIC_API_KEY=sk-ant-...

# Model override (optional). Defaults to claude-opus-4-7.
ANTHROPIC_MODEL=claude-opus-4-7

# Google Cloud project for the Firestore client.
# REQUIRED in production. Cloud Run injects GOOGLE_CLOUD_PROJECT automatically.
GOOGLE_CLOUD_PROJECT=root-and-fruit-app

# CORS allowlist (optional). Defaults to "*".
# Set to the frontend's public URL once the domain is final.
ALLOWED_ORIGIN=*

# ── Stripe (billing) ────────────────────────────────────────────────
# Both are secrets — mount from Secret Manager in production, never plaintext.
# If either is missing the webhook answers 500 and billing stays dormant; the
# rest of the app is unaffected.
#
# Use a TEST-mode key locally. The webhook signing secret is printed by:
#   stripe listen --forward-to localhost:8081/webhooks/stripe
# It differs per `stripe listen` session and per environment — a live secret
# will not verify test events, and vice versa.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public frontend URL Stripe returns the buyer to after checkout (optional).
# Falls back to the FIRST entry of ALLOWED_ORIGIN. If neither is set, the
# billing routes are disabled in production rather than sending a paying
# customer to localhost.
APP_URL=http://localhost:8080

# Hard ceiling on a single credit grant, whatever a price's metadata claims
# (optional). Defaults to 1000. This is the guard that keeps a dashboard typo
# from minting a fortune — see lib/plans.js.
MAX_CREDIT_GRANT=1000

# Port (optional). Defaults to 8080. Cloud Run injects this.
PORT=8080
